<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} | CIAJ</title>
  <meta name="description" content="{{ description or 'Blog jurídico-operativo de CIAJ para transporte, logística y comercio exterior.' }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=DM+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root { --navy:#011e62; --navy-dark:#000c2f; --gold:#ba9238; --gold-light:#d4ac55; --cream:#f8f7f4; --gray:#666; --radius:22px; }
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:"DM Sans",sans-serif;color:#171717;background:var(--cream);line-height:1.7}
    a{color:inherit;text-decoration:none}
    .container{width:min(1120px,calc(100% - 40px));margin:0 auto}
    .nav{position:sticky;top:0;z-index:100;background:rgba(8,8,8,.9);border-bottom:1px solid rgba(186,146,56,.28);backdrop-filter:blur(16px)}
    .nav-inner{min-height:74px;display:flex;align-items:center;justify-content:space-between;gap:18px}
    .brand{display:flex;align-items:center;gap:12px}
    .brand-mark{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;color:var(--gold);background:linear-gradient(135deg,var(--navy),var(--navy-dark));border:1px solid rgba(186,146,56,.45);font-family:"Playfair Display",serif;font-weight:900;font-size:20px}
    .brand-name{color:var(--gold);font-family:"Playfair Display",serif;font-weight:900;font-size:22px;line-height:1;display:block}
    .brand-sub{color:rgba(255,255,255,.58);text-transform:uppercase;letter-spacing:.13em;font-size:10px;display:block;margin-top:4px}
    .nav-links{display:flex;gap:20px;align-items:center;color:rgba(255,255,255,.75);font-size:13px;font-weight:700}
    .nav-links a:hover{color:var(--gold)}
    .btn{display:inline-flex;justify-content:center;align-items:center;min-height:46px;padding:12px 22px;border-radius:9px;font-size:12px;font-weight:900;letter-spacing:.04em;text-transform:uppercase;background:linear-gradient(135deg,var(--gold),var(--gold-light));color:#090909}
    .hero{padding:86px 0 70px;color:white;background:radial-gradient(circle at 88% 12%,rgba(186,146,56,.35),transparent 28%),linear-gradient(120deg,#000,#000c2f 45%,#011e62)}
    .eyebrow{color:var(--gold);text-transform:uppercase;letter-spacing:.14em;font-size:11px;font-weight:900;margin-bottom:14px}
    h1{font-family:"Playfair Display",serif;font-size:clamp(2.4rem,5vw,4.8rem);line-height:1.02;letter-spacing:-.045em;max-width:900px;margin-bottom:18px}
    .hero p{max-width:780px;color:rgba(255,255,255,.7);font-size:1.05rem}
    .section{padding:76px 0}
    .blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .card{overflow:hidden;border-radius:var(--radius);border:1px solid rgba(186,146,56,.28);background:rgba(255,255,255,.95);box-shadow:0 18px 48px rgba(1,30,98,.10);transition:.25s}
    .card:hover{transform:translateY(-6px);border-color:var(--gold)}
    .card-img{min-height:170px;background:radial-gradient(circle at 20% 20%,rgba(186,146,56,.55),transparent 34%),linear-gradient(135deg,rgba(1,30,98,.95),rgba(0,12,47,.98))}
    .card-img img{width:100%;height:210px;object-fit:cover;display:block}
    .card-body{padding:24px}
    .category{display:inline-block;color:var(--gold);text-transform:uppercase;letter-spacing:.12em;font-size:10px;font-weight:900;margin-bottom:10px}
    .card h2{color:var(--navy);font-family:"Playfair Display",serif;font-size:1.35rem;line-height:1.18;margin-bottom:10px}
    .card p{color:var(--gray);font-size:.92rem;margin-bottom:16px}
    .read-more{color:var(--navy);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.05em}
    .article{max-width:860px;margin:0 auto;background:#fff;border:1px solid rgba(186,146,56,.22);border-radius:26px;padding:min(7vw,56px);box-shadow:0 18px 48px rgba(1,30,98,.10)}
    .article-meta{color:var(--gold);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}
    .article h1{color:var(--navy);font-size:clamp(2rem,4vw,3.5rem)}
    .article img.featured{width:100%;max-height:430px;object-fit:cover;border-radius:18px;margin:28px 0}
    .article-content{color:#252525;font-size:1.04rem}
    .article-content h2,.article-content h3{color:var(--navy);font-family:"Playfair Display",serif;line-height:1.15;margin:34px 0 12px}
    .article-content p,.article-content ul,.article-content ol{margin-bottom:18px}
    .article-content ul,.article-content ol{padding-left:22px}
    footer{padding:26px 0;text-align:center;background:linear-gradient(120deg,var(--navy-dark),var(--navy));border-top:3px solid var(--gold);color:rgba(255,255,255,.5);font-size:12px}
    footer span{color:var(--gold);font-weight:900}
    @media(max-width:850px){.blog-grid{grid-template-columns:1fr}.nav-links{display:none}.brand-sub{display:none}.hero{padding:62px 0 52px}}
  </style>
</head>
<body>
  <header class="nav"><div class="container nav-inner"><a href="/" class="brand"><span class="brand-mark">C</span><span><span class="brand-name">CIAJ</span><span class="brand-sub">Centro Integral de Asistencia Jurídica</span></span></a><nav class="nav-links"><a href="/">Inicio</a><a href="/#servicios">Servicios</a><a href="/#valimax">ValiMax</a><a href="/blog/">Blog</a><a href="/#contacto">Contacto</a></nav><a class="btn" href="https://wa.me/5212228439714" target="_blank" rel="noopener">WhatsApp</a></div></header>
  {{ content | safe }}
  <footer><div class="container">© 2026 <span>CIAJ</span> · Centro Integral de Asistencia Jurídica · Blog jurídico-operativo para transporte y logística.</div></footer>
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</body>
</html>
